[Desktop Entry]
Type=Application
Name=Stereo
GenericName=Music Player
Comment=A music player in the spirit of classic iTunes, with Party Shuffle
Exec=stereo %F
Icon=stereo
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=music;player;itunes;playlist;shuffle;party;
MimeType=inode/directory;audio/mpeg;audio/flac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/mp4;audio/x-m4a;audio/wav;audio/x-wav;audio/aac;audio/aiff;
StartupWMClass=stereo
